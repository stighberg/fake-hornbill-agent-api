    {
      "name": "03 - Hornbill Request Read and Lifecycle",
      "description": "Read and update request lifecycle.",
      "item": [
        {
          "name": "Requests / getRequestRecord",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "ESP-APIKEY {{hornbillApiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "description": "Returns details for a request by requestId/reference.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@service\": \"apps/com.hornbill.servicemanager/Requests\",\n  \"@method\": \"getRequestRecord\",\n  \"params\": {\n    \"requestId\": \"{{lastHornbillRequestId}}\",\n    \"formatValues\": true,\n    \"returnRawValues\": true,\n    \"returnMeta\": false,\n    \"returnRelatedData\": true,\n    \"returnOneToManyData\": false,\n    \"returnActivityStreamAccessToken\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{hornbillBaseUrl}}/{{hornbillInstanceId}}/xmlmc/apps/com.hornbill.servicemanager/Requests",
              "host": [
                "{{hornbillBaseUrl}}/{{hornbillInstanceId}}/xmlmc/apps/com.hornbill.servicemanager/Requests"
              ]
            }
          },
          "event": [
            {
