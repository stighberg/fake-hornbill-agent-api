{
  "info": {
    "_postman_id": "ba2e068e-340c-469a-8460-a97b5645bf11",
    "name": "FakeHornBill + Hornbill API - Agent Demo",
    "description": "Postman collection for a Copilot Studio / agent escalation demo. Contains a fake agent-facing contract and selected Hornbill Service Manager XMLMC API calls for ticket creation, retrieval and lifecycle operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('ticketTitle')) { pm.environment.set('ticketTitle', 'Demo ticket from Copilot Studio'); }",
          "if (!pm.environment.get('ticketDescription')) { pm.environment.set('ticketDescription', 'This is a demo escalation created from the agent flow.'); }",
          "if (!pm.environment.get('conversationSummary')) { pm.environment.set('conversationSummary', 'User could not solve the issue through self-service and asked for support.'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - FakeHornBill Agent Contract",
      "description": "Use this folder first against Beeceptor, Mockoon Cloud, Postman Mock Server or another fake/demo backend. This is the contract Copilot Studio should call.",
      "item": [
        {
          "name": "Create Ticket - Agent Contract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "description": "Agent-friendly endpoint for creating a support ticket in the fake backend. This is the shape we want Copilot Studio to depend on.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requesterUserId\": \"{{demoRequesterUserId}}\",\n  \"requesterEmail\": \"{{demoRequesterEmail}}\",\n  \"title\": \"{{ticketTitle}}\",\n  \"description\": \"{{ticketDescription}}\",\n  \"category\": \"{{ticketCategory}}\",\n  \"priority\": \"{{ticketPriority}}\",\n  \"conversationSummary\": \"{{conversationSummary}}\",\n  \"metadata\": {\n    \"source\": \"CopilotStudio\",\n    \"correlationId\": \"{{$guid}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{fakeHornbillBaseUrl}}/tickets",
              "host": [
                "{{fakeHornbillBaseUrl}}/tickets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "let response = {};",
                  "try {",
                  "    response = pm.response.json();",
                  "} catch (e) {",
                  "    console.log(\"Response is not JSON\", e);",
                  "}",
                  "",
                  "const params = response.params || response;",
                  "const requestId =",
                  "    params.requestId ||",
                  "    params.requestRef ||",
                  "    params.h_pk_reference ||",
                  "    response.requestId ||",
                  "    response.requestRef ||",
                  "    response.ticketId;",
                  "",
                  "if (requestId) {",
                  "    pm.environment.set(\"lastHornbillRequestId\", requestId);",
                  "    console.log(\"Stored lastHornbillRequestId:\", requestId);",
                  "}",
                  "",
                  "const requestUrl = params.requestUrl || response.requestUrl || response.url;",
                  "if (requestUrl) {",
                  "    pm.environment.set(\"lastHornbillRequestUrl\", requestUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Ticket - Agent Contract",
          "request": {
            "method": "GET",
